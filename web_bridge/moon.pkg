import {
  "python123-ops/moonground/codec",
}

supported_targets = "js"

pkgtype(kind: "foreign_library")

options(
  link: {
    "js": {
      "exports": [
        "moonground_calibrate",
        "moonground_create",
        "moonground_update",
        "moonground_close",
        "moonground_project",
        "moonground_checkpoint",
        "moonground_restore",
        "moonground_reframe",
        "moonground_gates",
        "moonground_analysis",
        "moonground_health",
        "moonground_guarded",
        "moonground_transit",
        "moonground_gate_evidence",
        "moonground_evidence_analysis",
        "moonground_evidence_guarded",
        "moonground_evidence_transit",
        "moonground_evidence_transit_analysis",
        "moonground_evidence_guarded_transit",
      ],
      "format": "esm",
    },
  },
)
