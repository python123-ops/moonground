import {
  "python123-ops/moonground/codec",
}

supported_targets = "js"

pkgtype(kind: "foreign_library")

options(
  link: {
    "js": {
      "exports": [
        "moonground_calibrate",
        "moonground_create",
        "moonground_update",
        "moonground_close",
        "moonground_project",
        "moonground_checkpoint",
        "moonground_restore",
        "moonground_reframe",
        "moonground_gates",
      ],
      "format": "esm",
    },
  },
)
